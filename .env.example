# Copy to .env.local and fill in. Never commit .env.local.
# Vaani (vaanivoice.ai, key form vaani_...): read-only lookups of a finished call; the webhook URL carries the secret
VAANIVOICE_API_KEY=
VAANIVOICE_CLIENT_ID=          # optional: only for the OpenAPI call_details form
VAANIVOICE_WEBHOOK_SECRET=     # 24-128 chars of A-Z a-z 0-9 _ - ; set the webhook to https://<host>/api/vaanivoice/webhook/<this value>
VAANIVOICE_RATE_INR_PER_MIN=   # the dashboard's per-minute rate, to ESTIMATE voice cost
# Cal.com: the secret entered on the webhook in Cal.com settings (x-cal-signature-256)
CALCOM_SIGNING_SECRET=
PHONE_HASH_PEPPER=             # >= 16 chars
PHONE_ENC_KEY=                 # 64 hex chars (AES-256 key for caller phone numbers)
TOOL_SHARED_SECRET=            # bearer the voice platform sends to /api/tools/*
FRONT_DESK_NUMBER=
DESIGN_LEAD_NUMBER=

# Post-call extraction (paid tier ONLY: the free tier trains on content)
GEMINI_API_KEY=
GEMINI_PAID_TIER_CONFIRMED=    # set to true only after confirming billing is enabled

# Telegram: designer handoffs and alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=       # 16-256 chars of A-Z a-z 0-9 _ - ; also pass it to setWebhook as secret_token
OWNER_TELEGRAM_CHAT_ID=
NIKHIL_TELEGRAM_CHAT_ID=

# HubSpot: private-app token needs deal read/write, pipeline read, contacts read/write, owners read
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=           # internal id, read from the account (never guessed)
HUBSPOT_DEAL_STAGE_ID=

# Resend: the from-address must be on a domain verified in Resend
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=

# Google Calendar (service account; share each designer's calendar with its email)
GOOGLE_SERVICE_ACCOUNT_JSON=   # the key file's JSON, or base64 of it
GOOGLE_IMPERSONATE_USER=       # optional: domain-wide delegation, needed only to invite callers as attendees

# Owner dashboard (/dashboard): the token Nikhil types in
DASHBOARD_TOKEN=               # >= 16 chars

# Scheduled tick (Vercel Cron sends it as a bearer token)
CRON_SECRET=                   # >= 16 chars

# Later: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY

# Storage: DATABASE_URL = Postgres (Supabase); LOCAL_DB_DIR = local PGlite directory (migrations + seed applied on first use). Neither = in-memory (tests only).
DATABASE_URL=
LOCAL_DB_DIR=data/local/pglite
